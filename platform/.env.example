# Pilote local seulement. Copier en platform/.env (exclu de Git).
# Depuis la racine du dépôt : node --env-file=platform/.env platform/server.mjs
HOST=127.0.0.1
PORT=8787
DATABASE_PATH=./platform/.data/platform.sqlite
BLOB_DIR=./platform/.data/blobs

# Raccordement TAKATAK dédié à BESOINAVOCAT à valider avec son exploitant.
# Laisser vides tant que le contrat réel et le secret serveur ne sont pas fournis.
# Sans configuration : aucune identité de remplacement, API protégée indisponible.
TAKATAK_IDENTITY_URL=
TAKATAK_SERVICE_TOKEN=

# Public contact form: disabled until BOTH values are explicitly configured.
# JSON array of exact HTTPS origins; no wildcard or implicit WordPress origin.
# Separate private SQLite file, outside this repository and every web root.
# Keep its parent private (0700 on Unix), file 0600; never reuse the dossier DB.
BESOINAVOCAT_INTAKE_ALLOWED_ORIGINS=
BESOINAVOCAT_INTAKE_DB_PATH=

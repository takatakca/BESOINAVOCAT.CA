{
  "name": "BesoinAvocat — Portail",
  "short_name": "BesoinAvocat",
  "description": "Préparez votre dossier, suivez-le avec votre avocat.",
  "lang": "fr-CA",
  "dir": "ltr",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "orientation": "any",
  "background_color": "#f4f5f8",
  "theme_color": "#792936",
  "categories": [
    "business",
    "productivity"
  ],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Espace avocat",
      "url": "/avocat",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "short_name": "Espace avocat",
      "description": "Ouvrir l’espace réservé aux avocats"
    },
    {
      "name": "Aide",
      "url": "/aide",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "short_name": "Aide",
      "description": "Questions fréquentes et soutien"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/narrow-accueil.png",
      "sizes": "1082x2402",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Tableau de bord du dossier sur téléphone"
    },
    {
      "src": "/screenshots/narrow-demande.png",
      "sizes": "1082x2402",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Préparer mon dossier : la demande gratuite"
    },
    {
      "src": "/screenshots/wide-accueil.png",
      "sizes": "1440x900",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Espace de travail sur ordinateur"
    }
  ],
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "handle_links": "preferred",
  "edge_side_panel": {
    "preferred_width": 480
  },
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=ca.besoinavocat.portail",
      "id": "ca.besoinavocat.portail"
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+besoinavocat",
      "url": "/?lien=%s"
    }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": {
      "title": "titre",
      "text": "texte",
      "url": "lien"
    }
  }
}
